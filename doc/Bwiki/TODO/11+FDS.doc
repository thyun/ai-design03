=EC=95=84=EB=9E=98=EB=8A=94 false
AND (
  'service' IS NULL   -- [12] ?
      OR (
      '' IS NOT NULL   -- [14] ?
      )
  )
=EC=95=84=EB=9E=98=EB=8F=84 false
AND (
  'service' IS NULL   -- [12] ?
      OR (
      NULL IS NOT NULL   -- [14] ?
      )
  )
=EC=A6=89, '' =EB=8F=84 NULL =EC=B2=98=EB=9F=BC =EC=B2=98=EB=A6=AC=EB=90=A8

# JPQL
=09=09&lt;if test=3D"keywordCond2 !=3D null"&gt;
=09=09=09&lt;if test=3D"keywordCond2 =3D=3D 'service' and keyword !=3D null=
"&gt;
=09=09=09=09&lt;![CDATA[ AND tb2.service_name like '%' || #{keyword} || '%'=
 ]]&gt;
=09=09=09&lt;/if&gt;
=09=09=09&lt;if test=3D"keywordCond2 =3D=3D 'charger' and keyword !=3D null=
"&gt;
=09=09=09=09&lt;![CDATA[ AND tb3.chg_emp_no IN (select emp_no from ocbfds_u=
ser where emp_name like '%' || #{keyword} || '%') ]]&gt;
=09=09=09&lt;/if&gt;
=09=09&lt;/if&gt;
AND (
        'service' IS NULL   -- [12] ?
        OR (
            'service' =3D 'service' -- [13] ?
            AND '' IS NOT NULL   -- [14] ?
            AND tb2.SERVICE_NAME LIKE '%' || '' || '%' -- [15] ?
        )=20
        OR (
            'service' =3D 'charger' -- [16] ?
            AND '' IS NOT NULL   -- [17] ?
            AND tb3.CHG_EMP_NO IN (
                SELECT
                    EMP_NO=20
                FROM
                    OCBFDS_USER=20
                WHERE
                    EMP_NAME LIKE '%' || '' || '%' -- [18] ?
            )
        )
    )</pre>
</div>
