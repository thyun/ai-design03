<h1 id=3D"id-20=EC=98=A4=EB=8A=98=EB=89=B4=EC=8A=A4=EC=9A=B4=EC=98=81-DBque=
ry">DB query</h1>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence"># =EC=
=82=AC=EC=9A=A9=EC=9E=90 =EB=8D=B0=EC=9D=B4=ED=84=B0 =EC=B4=88=EA=B8=B0=ED=
=99=94 - 207548251, 199802860, 103262938
delete from onews_personal where mbr_id=3D'' and target_date=3D'2025-09-24'
delete from onews_reward where mbr_id=3D'' and target_date=3D'2025-09-24'
delete from etms_ad_reward_history where mbr_id=3D'' and reward_day=3D'2025=
0924'

# =EC=98=A4=EB=9E=98=EB=90=9C =EB=8D=B0=EC=9D=B4=ED=84=B0 =EC=82=AD=EC=A0=
=9C - =EC=84=9C=EB=B9=84=EC=8A=A4 =EC=8B=9C=EC=9E=91 2025=EB=85=84 4=EC=9B=
=94~
# onews_reward - target_date index =EB=AF=B8=EC=A1=B4=EC=9E=AC, create_date=
=EB=A7=8C =EC=A1=B4=EC=9E=AC
# onews_ad_reward - target_date =EB=8B=A8=EB=8F=85 index=EA=B0=80 =EC=97=86=
=EA=B3=A0 =EB=B3=B5=ED=95=A9 index=EB=A7=8C =EC=A1=B4=EC=9E=AC - target_dat=
e=EB=A1=9C query=EC=8B=9C =EB=B9=84=ED=9A=A8=EC=9C=A8=EC=A0=81
delete from onews_personal where target_date&gt;=3D'2025-04-01 00:00:00' an=
d target_date&lt;'2025-05-01 00:00:00';
delete from onews_reward where create_date&gt;=3D'2025-04-01 00:00:00' and =
create_date&lt;'2025-05-01 00:00:00';
delete from onews_ad_reward where create_date&gt;=3D'2025-04-01 00:00:00' a=
nd target_date&lt;'2025-05-01 00:00:00';</pre>
</div>
</div>
<p><br></p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence"># =EB=
=89=B4=EC=8A=A4 1=EA=B1=B4 =EC=9D=B4=EC=83=81 =EC=9D=BD=EC=9D=80 =EC=82=AC=
=EC=9A=A9=EC=9E=90 =EC=A1=B0=ED=9A=8C - =EC=97=AC=EB=9F=AC select query =EA=
=B2=B0=EA=B3=BC =ED=91=9C=EC=8B=9C - =EB=A7=88=EC=9A=B0=EC=8A=A4=EB=A1=9C =
=EC=98=81=EC=97=AD =EC=84=A0=ED=83=9D=ED=9B=84 Cmd + Shift + Enter
select count(distinct MBR_ID) from onews_reward where create_date&gt;=3D'20=
25-12-01 00:00:00' and create_date&lt;'2025-12-02 00:00:00' and action=3D'v=
iew-news';
select count(distinct MBR_ID) from onews_reward where create_date&gt;=3D'20=
25-12-02 00:00:00' and create_date&lt;'2025-12-03 00:00:00' and action=3D'v=
iew-news';
select count(distinct MBR_ID) from onews_reward where create_date&gt;=3D'20=
25-12-03 00:00:00' and create_date&lt;'2025-12-04 00:00:00' and action=3D'v=
iew-news';
SELECT
    DATE(create_date) AS create_day,
    COUNT(DISTINCT MBR_ID) AS distinct_member_count
FROM
    onews_reward
WHERE
    create_date &gt;=3D '2025-11-08 00:00:00'
    AND create_date &lt; '2025-11-16 00:00:00'
    AND action=3D'view-news'
GROUP BY
    create_day
ORDER BY
    create_day;

# =EC=9D=BC=EC=9D=BC =ED=86=B5=EA=B3=84
select count(distinct MBR_ID) from onews_reward where create_date&gt;=3D'20=
25-04-10 00:00:00' and create_date&lt;'2025-04-11 00:00:00';
select sum(point) from onews_reward where create_date&gt;=3D'2025-04-10 00:=
00:00' and create_date&lt;'2025-04-11 00:00:00';

select count(distinct MBR_ID) from onews_reward where create_date&gt;=3D'20=
25-05-27 00:00:00' and create_date&lt;'2025-05-28 00:00:00';
select sum(point) from onews_reward where create_date&gt;=3D'2025-05-27 00:=
00:00' and create_date&lt;'2025-05-28 00:00:00';

# =EC=9D=BC=EB=B3=84 =EA=B8=B0=EA=B0=84 =ED=86=B5=EA=B3=84 (=EB=8A=90=EB=A0=
=A4=EC=84=9C =EC=82=AC=EC=9A=A9 =EB=B9=84=EC=B6=94=EC=B2=9C)
SELECT
    DATE(create_date) AS create_day,
    COUNT(DISTINCT MBR_ID) AS distinct_member_count
FROM
    onews_reward
WHERE
    create_date &gt;=3D '2025-11-01 00:00:00'
    AND create_date &lt; '2025-11-08 00:00:00'
GROUP BY
    create_day
ORDER BY
    create_day;</pre>
</div>
</div>
<p><br></p>
