<div id=3D"expander-content-1025978347" class=3D"expand-content">
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">-- =ED=
=85=8C=EC=9D=B4=EB=B8=94 =EC=BB=AC=EB=9F=BC =EC=A1=B0=ED=9A=8C
SELECT * FROM user_tab_columns WHERE table_name =3D'JOYPOT_REWARD_DETAIL';
SELECT * FROM all_tab_columns@NXM_DL WHERE table_name =3D'EPP_MBR_CRDPNT_TR=
N';

SELECT * FROM nls_database_parameters WHERE parameter =3D 'NLS_CHARACTERSET=
';

-- =EB=A7=88=EC=A7=80=EB=A7=89 seq =ED=99=95=EC=9D=B8
SELECT * FROM ALL_SEQUENCES WHERE sequence_name =3D 'JOYPOT_PARTNER_POSITIO=
N_SEQ';

-- =EB=B0=B0=EC=A0=95 =EC=9D=B4=EB=A0=A5
SELECT NVL(SUM(rd.REWARD_POINT), 0)
FROM POTADM.JOYPOT_REWARD_DETAIL rd
         INNER JOIN POTADM.JOYPOT_REWARD_REQUEST rr ON rr.SEQ =3D rd.REQUES=
T_SEQ AND rr.PARTNER_SEQ =3D rd.PARTNER_SEQ
         INNER JOIN POTADM.JOYPOT_PARTNER_POINT_SETTING pps ON rd.PARTNER_P=
OINT_SETTING_SEQ =3D pps.SEQ
         INNER JOIN POTADM.JOYPOT_POINT_SETTING ps ON pps.POINT_SETTING_SEQ=
 =3D ps.SEQ
WHERE rd.EMPLOYEE_SEQ =3D 5224  -- JoypotEmployee=EC=9D=98 PK=EC=9D=B8 SEQ=
=EC=99=80 =EB=A7=A4=ED=95=91
  AND rd.CREATE_DATE &gt;=3D TO_DATE('2026-01-01 00:00:00', 'YYYY-MM-DD HH2=
4:MI:SS')  -- =EC=8B=9C=EC=9E=91=EC=9D=BC=EC=9E=90
  AND rd.CREATE_DATE &lt; TO_DATE('2027-01-01 00:00:00', 'YYYY-MM-DD HH24:M=
I:SS')   -- =EC=A2=85=EB=A3=8C=EC=9D=BC=EC=9E=90
  AND rd.RESULT =3D 'SUCCESS'
  AND rr.STATUS !=3D 'DEL'
  AND pps.STATUS =3D 'OK'
  AND ps.TRANS_TYPE =3D 'SAVE'
  AND ps.STATUS =3D 'OK';

SELECT * FROM SYN_MBR_CRDPNT_TRN
WHERE CRD_NO in (SELECT CARD_NUMBER FROM JOYPOT_CARD_ISSUE WHERE EMPLOYEE_S=
EQ=3D5224 AND STATUS !=3D 'DELETE')
  AND AVL_FR_DY &gt;=3D '20260101'
ORDER BY AVL_TO_DY ASC;

SELECT * FROM SYN_APR_DEALTR_TRN
WHERE CRD_NO in (SELECT CARD_NUMBER FROM JOYPOT_CARD_ISSUE WHERE EMPLOYEE_S=
EQ=3D7378 AND STATUS !=3D 'DELETE')
  AND SLP_CD in ('01')
  AND APRV_DY &gt;=3D '20260101';

-- =EC=B0=A8=EA=B0=90 =EC=9D=B4=EB=A0=A5
SELECT
    pps.POINT_NAME,
    rd.RESULT,
    rd.CREATE_DATE,
    rr.REASON,
    rd.REWARD_POINT
FROM JOYPOT_REWARD_DETAIL rd
         INNER JOIN JOYPOT_PARTNER_POINT_SETTING pps ON rd.PARTNER_POINT_SE=
TTING_SEQ =3D pps.seq
         INNER JOIN JOYPOT_POINT_SETTING ps ON pps.POINT_SETTING_SEQ =3D ps=
.seq
         INNER JOIN JOYPOT_REWARD_REQUEST rr ON rd.REQUEST_SEQ =3D rr.seq A=
ND rr.PARTNER_SEQ =3D pps.PARTNER_SEQ
WHERE rd.RESULT =3D 'SUCCESS'
  AND pps.status =3D 'OK'
  AND ps.status =3D 'OK'
  AND ps.TRANS_TYPE =3D 'USE'
  AND rd.EMPLOYEE_SEQ =3D 5226
ORDER BY rd.CREATE_DATE ASC;

-- =EC=82=AC=EC=9A=A9 =EC=9D=B4=EB=A0=A5 (=EB=B3=B5=EC=A7=80=EC=B9=B4=EB=93=
=9C/=EC=98=81=EC=88=98=EC=A6=9D =EC=8A=B9=EC=9D=B8 - =EC=96=B4=EB=93=9C=EB=
=AF=BC =EC=B0=A8=EA=B0=90=EB=B6=84 =EC=A0=9C=EC=99=B8)
SELECT
    *
FROM SYN_APR_DEALTR_TRN
WHERE CRD_NO IN (SELECT CARD_NUMBER FROM JOYPOT_CARD_ISSUE WHERE EMPLOYEE_S=
EQ =3D 7378 AND STATUS !=3D 'DELETE')
  AND JON_USE_SVC_CD =3D 'IC01'
  AND SLP_CD in ('11', '22', '30')
  AND PROC_FG in ('00')  -- ON=3D=EB=B3=B5=EC=A7=80=EC=B9=B4=EB=93=9C, 00=
=3D=EC=98=81=EC=88=98=EC=A6=9D =EC=8A=B9=EC=9D=B8
  AND APRV_DY &gt;=3D '20260101';

-- =EC=82=AC=EC=9A=A9 =EC=9D=B4=EB=A0=A5 (=EC=96=B4=EB=93=9C=EB=AF=BC =EC=
=B0=A8=EA=B0=90=EB=B6=84)
SELECT
    *
FROM SYN_APR_DEALTR_TRN
WHERE CRD_NO IN (SELECT CARD_NUMBER FROM JOYPOT_CARD_ISSUE WHERE EMPLOYEE_S=
EQ =3D 1442 AND STATUS !=3D 'DELETE')
  AND JON_USE_SVC_CD =3D 'IC01'
  AND SLP_CD in ('11', '22', '30')
  AND PROC_FG !=3D 'ON' AND PROC_FG !=3D '00'
  AND APRV_DY &gt;=3D '20260101';

-- =EC=98=81=EC=88=98=EC=A6=9D =EC=8A=B9=EC=9D=B8 =EB=82=B4=EC=97=AD
SELECT
             e.EMPLOYEE_ID, e.EMPLOYEE_TYPE, e.NAME, p.NAME as POSITION_NAM=
E,
             t.BANK_NAME, t.ACCOUNT_NO,
             t.RECEIPT_DATE, t.REQUEST_POINT,
             t.MERCHANT_NAME, t.PURCHASE_DETAIL,
             t.APPROVE_DATE, t.APPROVE_POINT,
             w.NAME as WELFARE_CATEGORY_NAME,
             t.RESULT_STATUS
          FROM JOYPOT_RECEIPT_REQUEST t
          LEFT JOIN JOYPOT_EMPLOYEE e ON t.EMPLOYEE_SEQ =3D e.SEQ
          LEFT JOIN JOYPOT_PARTNER_POSITION p ON e.POSITION_SEQ =3D p.SEQ
          LEFT JOIN JOYPOT_WELFARE_CATEGORY w ON t.WELFARE_CATEGORY_SEQ =3D=
 w.SEQ
          WHERE (t.PARTNER_SEQ =3D 7)
            AND (t.EMPLOYEE_SEQ =3D 1684)
            AND (t.APPROVE_DATE &gt;=3D TO_DATE('20260201', 'YYYYMMDD') AND=
 t.APPROVE_DATE &lt; TO_DATE(:'20260228', 'YYYYMMDD'))
            AND (t.RESULT_STATUS =3D 'SUCCESS')
          ORDER BY t.APPROVE_DATE ASC

-- =EA=B8=B0=ED=83=80
SELECT * FROM POTADM.JOYPOT_REWARD_REQUEST jrr
                  JOIN POTADM.JOYPOT_REWARD_DETAIL jrd ON jrd.REQUEST_SEQ =
=3D jrr.SEQ AND jrd.PARTNER_SEQ =3D jrr.PARTNER_SEQ
WHERE jrr.PARTNER_SEQ =3D 1
  AND jrd.EMPLOYEE_SEQ =3D 5226;</pre>
